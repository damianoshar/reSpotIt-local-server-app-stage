@echo off
REM start-full-stack.bat — Generate secrets, configure .env, and launch the full stack.
REM Usage: start-full-stack.bat
setlocal enabledelayedexpansion

cd /d "%~dp0"

REM ── Generate secrets ──────────────────────────────────────────────────────────
for /f "delims=" %%a in ('python -c "import secrets; print(secrets.token_hex(32))"') do set WEBUI_SECRET_KEY=%%a
for /f "delims=" %%a in ('python -c "import secrets; print(secrets.token_urlsafe(24))"') do set MCP_API_KEY=%%a
for /f "delims=" %%a in ('python -c "import secrets; print(secrets.token_urlsafe(24))"') do set RESPOTIT_MCP_TOKEN=%%a
for /f "delims=" %%a in ('python -c "import secrets; print(secrets.token_urlsafe(24))"') do set RESPOTIT_MCP_PASSWORD=%%a
for /f "delims=" %%a in ('python -c "import secrets; print(secrets.token_urlsafe(24))"') do set KEYCLOAK_ADMIN_PASSWORD=%%a
for /f "delims=" %%a in ('python -c "import secrets; print(secrets.token_urlsafe(24))"') do set KEYCLOAK_DB_PASSWORD=%%a
for /f "delims=" %%a in ('python -c "import secrets; print(secrets.token_urlsafe(24))"') do set OAUTH_CLIENT_SECRET=%%a
for /f "delims=" %%a in ('python -c "import secrets; print(secrets.token_urlsafe(24))"') do set OPENWEBUI_DB_PASSWORD=%%a

REM ── Write .env ────────────────────────────────────────────────────────────────
(
echo # reSpotIt local server (auto-generated by start-full-stack.bat)
echo REDIRECT_URI=https://127.0.0.1:8000/api/v1/auth/callback
echo PUBLIC_BASE_URL=https://127.0.0.1:8000
echo SSL_ENABLED=true
echo CORS_ALLOW_ORIGIN=*
echo FORWARDED_ALLOW_IPS=*
echo.
echo # Spotify (fill in manually)
echo SPOTIFY_CLIENT_ID=
echo SPOTIFY_CLIENT_SECRET=
echo.
echo # Keycloak / OpenWebUI OIDC
echo KEYCLOAK_REALM=open-webui
echo KEYCLOAK_ADMIN=admin
echo KEYCLOAK_ADMIN_PASSWORD=!KEYCLOAK_ADMIN_PASSWORD!
echo KEYCLOAK_DB_USER=keycloak
echo KEYCLOAK_DB_PASSWORD=!KEYCLOAK_DB_PASSWORD!
echo KEYCLOAK_HOSTNAME=https://localhost/authKeycloak
echo OPENID_PROVIDER_URL=https://localhost/authKeycloak/realms/open-webui/.well-known/openid-configuration
echo OPENID_REDIRECT_URI=https://localhost/oauth/oidc/callback
echo OAUTH_PROVIDER_NAME=Keycloak
echo OAUTH_SCOPES=openid email profile
echo OAUTH_CLIENT_ID=open-webui
echo OAUTH_CLIENT_SECRET=!OAUTH_CLIENT_SECRET!
echo OAUTH_AUTO_SIGNUP=true
echo OAUTH_MERGE_ACCOUNTS_BY_EMAIL=true
echo ENABLE_OAUTH_SIGNUP=true
echo.
echo # OpenWebUI database
echo OPENWEBUI_DB_USER=openwebui
echo OPENWEBUI_DB_PASSWORD=!OPENWEBUI_DB_PASSWORD!
echo OPENWEBUI_DB_NAME=openwebui
echo WEBUI_AUTH=true
echo DEFAULT_USER_ROLE=user
echo WEBUI_SECRET_KEY=!WEBUI_SECRET_KEY!
echo.
echo # Spotify MCP
echo SPOTIFY_CLIENT_ID=
echo MCP_API_KEY=!MCP_API_KEY!
echo.
echo # reSpotIt MCP service account
echo RESPOTIT_MCP_EMAIL=mcp-service@respotit.local
echo RESPOTIT_MCP_PASSWORD=!RESPOTIT_MCP_PASSWORD!
echo RESPOTIT_MCP_USER_ID=
echo RESPOTIT_MCP_API_URL=https://api:8000
echo RESPOTIT_MCP_API_VERIFY_TLS=false
echo RESPOTIT_MCP_TOKEN=!RESPOTIT_MCP_TOKEN!
echo.
echo # OpenWebUI integration
echo WEBUI_AUTH_TRUSTED_EMAIL_HEADER=X-OWUI-Trusted-Email
echo WEBUI_AUTH_TRUSTED_NAME_HEADER=X-OWUI-Trusted-Name
echo OPENWEBUI_TRUSTED_AUTH=true
echo OPENWEBUI_URL=http://open-webui:8080
echo.
echo # External model endpoint (llama-server)
echo OPENAI_API_BASE_URL=http://host.docker.internal:8080/v1
echo OPENAI_API_KEY=local
echo.
echo # Telemetry
echo SCARF_NO_ANALYTICS=true
echo DO_NOT_TRACK=true
echo ANONYMIZED_TELEMETRY=false
) > .env

echo [OK] .env generated with random secrets.

REM ── Copy required files from backup workspace ─────────────────────────────────
set "BACKUP_DIR=..\reSpotIt-local-server-app-clean-backup-2"
if exist "%BACKUP_DIR%\certs" (
    xcopy /E /I /Y "%BACKUP_DIR%\certs" "certs" >nul 2>&1
    echo [OK] Copied certs/
)
if exist "%BACKUP_DIR%\OpenWebUI-stack" (
    xcopy /E /I /Y "%BACKUP_DIR%\OpenWebUI-stack" "OpenWebUI-stack" >nul 2>&1
    echo [OK] Copied OpenWebUI-stack/
)

REM ── Launch full stack ─────────────────────────────────────────────────────────
echo [..] Starting full stack...
docker compose -f docker-compose.yml -f docker-compose.full.yml up -d --build

echo.
echo [OK] Full stack started!
echo    reSpotIt frontend: http://localhost:8888
echo    reSpotIt API:      https://localhost:8000
echo    OpenWebUI:         https://localhost/owui/
echo    Keycloak Admin:    https://localhost/authKeycloak/admin/
echo    MinIO Console:     http://localhost:9001
echo    Redis Insight:     http://localhost:5540